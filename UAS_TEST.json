    "/v1/sms": {
      "post": {
        "tags": [
          "Sms"
        ],
        "summary": "Submit SMS",
        "description": "Submits the supplied message once. Recipient statuses report provider submission results, not handset delivery. Provider errors retain their HTTP status.",
        "parameters": [
          {
            "name": "Source",
            "in": "header",
            "required": true,
            "schema": {
              "enum": [
                "hybris"
              ],
              "type": "string"
            }
          },
          {
            "name": "x-transaction-id",
            "in": "header",
            "description": "Caller tracking identifier; a UUID is generated when absent",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SmsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "x-transaction-id": {
                "description": "The request tracking identifier; available after SMS validation begins",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "SmsBearer": [ ]
          }
        ]
      }
    },
