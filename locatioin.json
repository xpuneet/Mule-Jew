    "/Legacy/location/find-branches/{Postcode}": {
      "get": {
        "tags": [
          "Legacy Location"
        ],
        "summary": "Find branches near a postcode (legacy-compatible).",
        "description": "Authentication: Required - Server JWT Bearer (scheme `LocationServiceAccount`, JWT aud `StoresServiceReader`).",
        "parameters": [
          {
            "name": "Postcode",
            "in": "path",
            "description": "A valid UK postcode",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Radius",
            "in": "query",
            "description": "Distance from postcode in miles. Default is 10.",
            "schema": {
              "pattern": "^((?!(0))[0-9]+)$",
              "type": "string"
            }
          },
          {
            "name": "ResultLimit",
            "in": "query",
            "description": "Maximum number of branches to return. Default is 25.",
            "schema": {
              "pattern": "^((?!(0))[0-9]+)$",
              "type": "string"
            }
          },
          {
            "name": "Brand",
            "in": "query",
            "description": "Optional brand code(s) for filtering (comma-separated). When omitted, no brand filter is applied.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ApiRunMode",
            "in": "header",
            "description": "Selects which service implementation handles a request.",
            "schema": {
              "$ref": "#/components/schemas/ApiRunMode"
            }
          },
          {
            "name": "SessionCorrelationId",
            "in": "query",
            "description": "Session correlation ID used to link logged requests to a session for tracking errors",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "TransactionCorrelationId",
            "in": "query",
            "description": "Transaction correlation ID used to link logged requests to a transaction for tracking errors",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BranchSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
